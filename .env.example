# Documentación: docs/README.md
# CLI: docs/cli.md  ·  OCR: docs/ocr.md

# Directorio de datos (fuera del repo). Por defecto el volumen local.
AEAT_HUB_DATA_DIR=/Volumes/SSDCX9/data/aeat-hub

# Unlimited-OCR (opcional, no es el motor por defecto en Apple Silicon)
# Servidor llama.cpp / vLLM compatible OpenAI:
# AEAT_HUB_UNLIMITED_OCR_URL=http://127.0.0.1:8080/v1/chat/completions
# O ruta a un GGUF + mmproj (requiere llama-mtmd-cli en PATH):
# AEAT_HUB_UNLIMITED_OCR_GGUF=/ruta/Unlimited-OCR-Q4_K_M.gguf
# AEAT_HUB_UNLIMITED_OCR_MMPROJ=/ruta/mmproj-Unlimited-OCR-F16.gguf

# PaddleOCR-VL (opcional, pesado). 1 para intentar usarlo si está instalado.
# AEAT_HUB_PADDLEOCR_VL=0

# DeepSeek-OCR vía Ollama (opcional). El daemon debe estar arriba y el modelo bajado:
# ollama serve
# ollama pull deepseek-ocr
# AEAT_HUB_OLLAMA_URL=http://127.0.0.1:11434
# AEAT_HUB_OLLAMA_OCR_MODEL=deepseek-ocr
