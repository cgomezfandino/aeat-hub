# Documentación: docs/README.md
# CLI: docs/cli.md  ·  OCR: docs/ocr.md

# Directorio de datos (fuera del repo). Por defecto el volumen local.
AEAT_HUB_DATA_DIR=/Volumes/SSDCX9/data/aeat-hub

# Google Gemini API Key (Vision AI / Extracción estructurada)
# GEMINI_API_KEY=AIzaSy...
# AEAT_HUB_GEMINI_MODEL=gemini-2.5-flash

# Unlimited-OCR (opcional, no es el motor por defecto en Apple Silicon)
# Servidor llama.cpp / vLLM compatible OpenAI:
# AEAT_HUB_UNLIMITED_OCR_URL=http://127.0.0.1:8080/v1/chat/completions
# O ruta a un GGUF + mmproj (requiere llama-mtmd-cli en PATH):
# AEAT_HUB_UNLIMITED_OCR_GGUF=/ruta/Unlimited-OCR-Q4_K_M.gguf
# AEAT_HUB_UNLIMITED_OCR_MMPROJ=/ruta/mmproj-Unlimited-OCR-F16.gguf

# PaddleOCR-VL (opcional, pesado). 1 para intentar usarlo si está instalado.
# AEAT_HUB_PADDLEOCR_VL=0

# DeepSeek-OCR vía Ollama (opcional). El daemon debe estar arriba y el modelo bajado:
# ollama serve
# ollama pull deepseek-ocr
# AEAT_HUB_OLLAMA_URL=http://127.0.0.1:11434
# AEAT_HUB_OLLAMA_OCR_MODEL=deepseek-ocr

# --- API del motor fiscal (aeat-hub api) -------------------------------------
# Token que exige la API. Si falta, se genera en <data-dir>/api-token (0600)
# y la web lo lee con AEAT_HUB_API_TOKEN_FILE. Obligatorio fuera de localhost.
# AEAT_HUB_API_TOKEN=cambia-esto-por-32-caracteres-aleatorios
# Hosts que acepta la API (anti DNS rebinding).
# AEAT_HUB_API_HOSTS=127.0.0.1,localhost,api

# --- Web (Next.js, carpeta web/) -----------------------------------------------
# AEAT_HUB_API_URL=http://127.0.0.1:8000
# AEAT_HUB_API_TOKEN_FILE=/Volumes/SSDCX9/data/aeat-hub/api-token
# Login: sin contraseña la web no pide acceso y solo debe escuchar en 127.0.0.1.
# En la nube son obligatorias las dos (secreto de al menos 32 caracteres).
# AEAT_HUB_WEB_PASSWORD=          # mínimo 16 caracteres
# AEAT_HUB_WEB_SECRET=            # mínimo 32 caracteres
# Dominio(s) públicos de la web en la nube (anti DNS rebinding). En local no hace falta.
# AEAT_HUB_WEB_HOSTS=hub.tudominio.es
