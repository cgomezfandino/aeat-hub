# Motor fiscal + API. OCR local con RapidOCR (Apple Vision solo existe en macOS);
# con GEMINI_API_KEY la extracción va por Gemini.
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
RUN uv sync --frozen --no-dev
RUN useradd --create-home --uid 10001 aeat && mkdir -p /data && chown aeat /data
USER aeat
ENV AEAT_HUB_DATA_DIR=/data PATH="/app/.venv/bin:$PATH"
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/api/salud')"
CMD ["sh", "-c", "aeat-hub init --data-dir /data >/dev/null 2>&1 || true; exec aeat-hub api --host 0.0.0.0 --port 8000"]
